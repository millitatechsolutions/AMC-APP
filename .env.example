# Optional Google Maps browser configuration. Copy to .env and fill locally.
# Browser keys are visible to browsers: restrict the key to Maps JavaScript API
# and your allowed website HTTP referrers in Google Cloud. Never use a server key.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Google Cloud map ID; the demo uses DEMO_MAP_ID when empty.
GOOGLE_MAPS_MAP_ID=

# Online hosting is configured separately by render.yaml.
# Keep this local example in localhost mode. See docs/online-hosting.md
# for the persistent disk, public HTTPS origin and private first-owner setup key.
